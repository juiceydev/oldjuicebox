// Allow only the dedicated updater account to restart the packaged Juicebox units.
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var allowed = [
        "juiceback.service",
        "juicehost.service",
        "juicefront.service",
        "juicefetch.service"
    ];
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "juicefetch" &&
        (verb == "restart" || verb == "try-restart") &&
        allowed.indexOf(unit) >= 0) {
        return polkit.Result.YES;
    }
});
