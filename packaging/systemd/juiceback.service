[Unit]
Description=Juicebox² backend (juiceback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/juicebox/current
ExecStart=/var/lib/juicebox/current/bin/juiceback
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
