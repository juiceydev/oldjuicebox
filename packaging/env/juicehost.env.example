PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=6402
# QUIC is the only directly public Juicebox listener. Permit UDP 6403 only.
QUIC_HOST=0.0.0.0
QUIC_PORT=6403
WORKER_THREADS=8
FILES_DIR=/var/lib/juicebox/state/juicehost/files
BACKEND_URL=http://127.0.0.1:6401
ALLOWED_ORIGINS=http://127.0.0.1:6401
MIN_FREE_SPACE_GB=5
MAX_FILE_SIZE_MB=500
QUICK_LINK=true
CUSTOM_ID=true
DANGER_LEVEL=high
DEFAULT_TTL_HOURS=24
ALLOWED_TTL_HOURS=0.5,1,6,12,24,72,168
QUIC_CERT_PATH=/var/lib/juicebox/state/juicehost/quic-cert.der
JUICEHOST_API_KEY=
TICKET_JWT_SECRET=
IP_PEPPER=
BAN_LIST_FILE=/var/lib/juicebox/state/juicehost/bans.json
BAN_SYNC_URL=http://127.0.0.1:6401
BAN_SYNC_INTERVAL=30
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
MAX_RANGE_RESPONSE_MB=16
MAX_CONCURRENT_UPLOADS=16
MAX_CONCURRENT_DOWNLOADS=64
MAX_CONCAT_PARTS=128
TCP_BODY_INACTIVITY_SECONDS=30
TCP_REQUEST_TOTAL_SECONDS=600
QUIC_MAX_CONNECTIONS=256
QUIC_MAX_REQUESTS=256
QUIC_HANDSHAKE_SECONDS=10
QUIC_IDLE_SECONDS=30
QUIC_REQUEST_TOTAL_SECONDS=600
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENTRY_DSN=
SENTRY_DSN_JUICEHOST=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
