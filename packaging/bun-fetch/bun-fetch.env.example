# juicebox-bun-fetch env (primary: /var/lib/juicebox/bun-fetch.env)
# Secondary: /var/lib/bun-fetch/bun-fetch.env (see install-secondary.sh)

# Bind address. Primary: localhost only (juiceback dials it directly).
# Secondary: 0.0.0.0 so the primary reaches it over tailscale (Bearer-gated).
HOST=127.0.0.1
PORT=7673

# Shared bearer token. Must match juiceback's BUN_FETCH_KEY.
# Generate: openssl rand -hex 32
BUN_FETCH_KEY=

# yt-dlp binary + PO-token provider (bgutil HTTP server).
YTDLP_BIN=/usr/local/bin/yt-dlp
# Primary: tailscale address of the secondary's bgutil provider.
# Secondary: http://127.0.0.1:4416 (localhost, no tailscale flakes).
YTDLP_POT_BASE_URL=http://100.81.219.120:4416

# YouTube cookies (Netscape format). Must be readable AND writable by the
# service user — yt-dlp saves session cookies back into this file.
YTDLP_COOKIES=/var/lib/juicebox/ytdlp-tmp/cookies.txt

# Scratch dir for downloads (job-scoped subdirs, auto-cleaned).
YTDLP_TMPDIR=/var/lib/juicebox/bun-fetch-tmp

# JS challenge runtimes for yt-dlp EJS (sig + n-throttle solving).
# Bun first: fastest solver, fewest "Only images are available" drops.
YTDLP_JS_RUNTIME=bun:/usr/local/bin/bun,deno:/usr/local/bin/deno

# Egress for yt-dlp. Primary: secondary tinyproxy (residential IP).
# Secondary: leave EMPTY for direct residential egress (best SABR outcome).
FETCH_PROXY=http://100.81.219.120:8888

# Per-fetch timeout and safety caps.
FETCH_TIMEOUT_SECS=1500
SERVICE_MAX_BYTES=2147483648
MAX_JOBS=2
