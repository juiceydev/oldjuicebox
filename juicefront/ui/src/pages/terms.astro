---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { getFormattedCommitLabel, getRepoUrl } from "../lib/metadata";
import { readPublicFile, renderTxtToHtml } from "../lib/legal";
import { t, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const footerCommit = getFormattedCommitLabel();
const canonicalUrl = getRepoUrl();

const customActions = [
    {
        id: "back",
        label: t(locale, "nav.back"),
        icon: "back",
        ariaLabel: t(locale, "nav.back_aria"),
    },
    { id: "files", label: t(locale, "nav.files"), icon: "files" },
    { id: "more", label: t(locale, "nav.more"), icon: "more" },
];

const raw = readPublicFile("terms-of-service.txt");
const contentHtml = renderTxtToHtml(raw);
---

<BaseLayout
    title={`${t(locale, "terms.title")} - Juicebox`}
    description={t(locale, "terms.title")}
    canonical={canonicalUrl}
    bodyClass="content-page"
>
    <main id="main-content" transition:animate="none">
        <ContentCard
            title={t(locale, "terms.title")}
            subtitle={t(locale, "terms.subtitle")}
            footerCommit={footerCommit}
            footerRepoUrl={canonicalUrl}
            actions={customActions}
        >
            <Fragment set:html={contentHtml} />
        </ContentCard>
    </main>
</BaseLayout>
