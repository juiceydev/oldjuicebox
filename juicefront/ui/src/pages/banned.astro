---
import BaseLayout from "../layouts/BaseLayout.astro";
import { checkUserBan } from "../lib/ban";
import { t, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ban = await checkUserBan(Astro.request);
if (!ban.banned) return Astro.redirect("/");
const reason = ban.reason ?? "";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "";
---

<BaseLayout
    title={t(locale, "banned.title")}
    description={t(locale, "banned.description")}
    bodyClass="content-page"
>
    <main id="main-content" transition:animate="none">
        <div class="upload-card content-card">
            <header class="upload-header upload-header--centered">
                <h1 class="upload-header__title">{t(locale, "banned.heading")}</h1>
                <p class="upload-header__subtitle">{t(locale, "banned.description")}</p>
            </header>
            <section class="content-body">
                {reason ? (
                    <p>{t(locale, "banned.reason_label")} {reason}</p>
                ) : (
                    <p>{t(locale, "banned.no_reason")}</p>
                )}
                {contactEmail && (
                    <p style="margin-top: 1rem; color: var(--juice-400); font-size: 0.85rem;">
                        {t(locale, "banned.contact_with_email")}{" "}
                        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
                    </p>
                )}
                {!contactEmail && (
                    <p style="margin-top: 1rem; color: var(--juice-400); font-size: 0.85rem;">
                        {t(locale, "banned.contact_no_email")}
                    </p>
                )}
                <p style="margin-top: 1rem;">
                    <a href="/">{t(locale, "banned.return")}</a>
                </p>
            </section>
        </div>
    </main>
</BaseLayout>
