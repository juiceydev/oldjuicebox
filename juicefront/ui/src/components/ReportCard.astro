---
/**
 * HTML-first report card. A plain <form> posting to the backend's no-JS
 * /api/report endpoint, with native browser validation (required, type=url).
 * No JavaScript involved at all.
 */
import UploadHeader from "./UploadHeader.astro";
import UploadFooter from "./UploadFooter.astro";
import ActionsGrid from "./ActionsGrid.astro";
import { getRepoUrl } from "../lib/metadata";
import { t, resolveLocale } from "../i18n";

interface Props {
    id?: string;
    title?: string;
    subtitle?: string;
    submitted?: boolean;
    footerCommit?: string;
    footerMessage?: string;
    footerRepoUrl?: string;
    footerLinks?: {
        label: string;
        href: string;
        external?: boolean;
        ariaLabel?: string;
    }[];
    actions?: {
        id?: string;
        label: string;
        icon?: string;
        ariaLabel?: string;
        href?: string;
        disabled?: boolean;
    }[];
}

const locale = resolveLocale(Astro.currentLocale);

const {
    id,
    title = t(locale, "report.title"),
    subtitle = t(locale, "report.subtitle"),
    submitted = false,
    footerCommit = "main@a3f8c2d",
    footerMessage = "juicebox2-epsilon",
    footerRepoUrl = getRepoUrl(),
    footerLinks = [],
    actions,
} = Astro.props as Props;

const cardId = id ?? "report-card";
const headerId = `${cardId}-header`;
const actionsGridId = `${cardId}-actions`;

const reportReasons = [
    { value: "malware", label: t(locale, "report.reason_malware") },
    { value: "illegal", label: t(locale, "report.reason_illegal") },
    { value: "copyright", label: t(locale, "report.reason_copyright") },
    { value: "spam", label: t(locale, "report.reason_spam") },
    { value: "inappropriate", label: t(locale, "report.reason_inappropriate") },
    { value: "other", label: t(locale, "report.reason_other") },
];
---

<div
    id={cardId}
    class="upload-card report-card"
    data-report-card
    data-component="report-card"
    aria-labelledby={headerId}
    transition:name="main-card"
>
    <UploadHeader id={headerId} title={title} subtitle={subtitle} />

    <section class="rpfcontainer" data-report-form>
        <div class="rpfcontent">
            {submitted && (
                <div class="report-success-banner" role="alert">
                    <p><strong>{t(locale, "report.success")}</strong></p>
                </div>
            )}
            <form method="POST" action="/api/report" class="report-form" data-astro-reload>
                <div class="form-field">
                    <label for={`${cardId}-url`} class="form-label">
                        {t(locale, "report.url_label")} <span class="required">*</span>
                    </label>
                    <input
                        id={`${cardId}-url`}
                        type="url"
                        name="file_url"
                        class="form-input"
                        required
                        placeholder="https://example.com/f/abc123"
                    />
                    <p class="form-help-text">
                        {t(locale, "report.url_hint")}
                    </p>
                </div>

                <div class="form-field">
                    <label for={`${cardId}-reason`} class="form-label">
                        {t(locale, "report.reason_label")} <span class="required">*</span>
                    </label>
                    <select
                        id={`${cardId}-reason`}
                        name="reason"
                        class="form-select"
                        required
                    >
                        <option value="" disabled selected>
                            {t(locale, "report.reason_placeholder")}
                        </option>
                        {
                            reportReasons.map((r) => (
                                <option value={r.value}>{r.label}</option>
                            ))
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label for={`${cardId}-details`} class="form-label">
                        {t(locale, "report.details_label")}
                    </label>
                    <textarea
                        id={`${cardId}-details`}
                        name="details"
                        class="form-textarea"
                        rows="4"
                        maxlength="500"
                        placeholder={t(locale, "report.details_placeholder")}
                    ></textarea>
                    <p class="form-help-text">{t(locale, "report.details_max")}</p>
                </div>

                <div class="form-field">
                    <label for={`${cardId}-email`} class="form-label">
                        {t(locale, "report.email")}
                    </label>
                    <input
                        id={`${cardId}-email`}
                        type="email"
                        name="email"
                        class="form-input"
                        placeholder="you@example.com"
                    />
                    <p class="form-help-text">
                        {t(locale, "report.email_hint")}
                    </p>
                </div>

                <div class="rpfactions">
                    <button
                        type="submit"
                        class="report-btn report-btn--primary"
                    >
                        {t(locale, "report.submit")}
                    </button>
                </div>
            </form>

            <div class="rpffooter">
                <p class="report-footer-text">
                    {t(locale, "report.warning")}
                </p>
            </div>
        </div>
    </section>

    {
        actions && (
            <ActionsGrid
                id={actionsGridId}
                actions={actions}
                heading={t(locale, "actions.report_actions")}
            />
        )
    }

    <UploadFooter
        commit={footerCommit}
        message={footerMessage}
        repoUrl={footerRepoUrl}
        links={footerLinks}
    />
</div>
