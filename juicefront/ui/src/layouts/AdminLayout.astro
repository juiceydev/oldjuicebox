---
export interface Props {
    title?: string;
}

const { title = "Admin - Juicebox" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Juicebox admin panel for managing uploads, reports, and bans." />
    <title>{title}</title>
    <style>
        .skip-link {
            position: absolute;
            top: -100%;
            left: 0;
            z-index: 9999;
            padding: 0.5rem 1rem;
            background: #ea580c;
            color: #000;
            text-decoration: none;
            border-radius: 0 0 0.5rem 0;
            white-space: nowrap;
        }
        .skip-link:focus {
            top: 0;
        }
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 1rem;
            color: #e0e0e0;
            background: #111;
            line-height: 1.5;
        }
        h1 { margin: 0 0 0.25rem; }
        h2 { margin: 1rem 0 0.5rem; font-size: 1.1rem; }
        a { color: #ea580c; }
        hr { border: none; border-top: 1px solid #333; margin: 1rem 0; }
        table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
        th, td { padding: 0.4rem 0.6rem; border: 1px solid #333; text-align: left; }
        th { background: #1a1a1a; position: sticky; top: 0; cursor: pointer; user-select: none; }
        th:hover { background: #252525; }
        tr.expired { opacity: 0.5; }
        .admin-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            margin-bottom: 0.75rem;
        }
        .admin-toolbar input[type="text"],
        .admin-toolbar select {
            background: #1a1a1a;
            color: #e0e0e0;
            border: 1px solid #444;
            padding: 0.35rem 0.5rem;
            border-radius: 4px;
            font-size: 0.85rem;
        }
        .admin-toolbar input[type="text"] { flex: 1; min-width: 180px; }
        .admin-toolbar select { min-width: 120px; }
        .admin-toolbar input:focus,
        .admin-toolbar select:focus {
            outline: none;
            border-color: #ea580c;
        }
        .btn {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border: 1px solid #444;
            border-radius: 4px;
            background: #1a1a1a;
            color: #e0e0e0;
            cursor: pointer;
            font-size: 0.85rem;
            text-decoration: none;
        }
        .btn:hover { background: #252525; }
        .btn-primary { background: #ea580c; color: #fff; border-color: #ea580c; }
        .btn-primary:hover { background: #c96b0a; }
        .admin-status {
            font-size: 0.85rem;
            color: #888;
            margin-top: 0.5rem;
        }
        .table-wrap { overflow-x: auto; }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
        <slot />
    </main>
</body>
</html>
