# Adsterra ad zone keys (read by the Astro build via envDir = repo root).
# Set to your own Adsterra zone ids to enable ads; any zone left empty is
# skipped. Ads render only when ADTESTING=true is toggled on in the browser
# via the G-A-D-E chord shortcut.
PUBLIC_ADSTERRA_SKYSCRAPER_160X600=
PUBLIC_ADSTERRA_SKYSCRAPER_160X300=
PUBLIC_ADSTERRA_LEADERBOARD_468X60=
PUBLIC_ADSTERRA_MOBILE_BANNER_320X50=
