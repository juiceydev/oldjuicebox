PUBLIC_ADSTERRA_SKYSCRAPER_160X600=
PUBLIC_ADSTERRA_SKYSCRAPER_160X300=
PUBLIC_ADSTERRA_LEADERBOARD_468X60=
PUBLIC_ADSTERRA_MOBILE_BANNER_320X50=
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# Empty is the safe default. For local Caddy, explicitly set 127.0.0.1/32.
TRUSTED_PROXY_CIDRS=
REPORT_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=90

# JuiceBox x Cobalt.Tools URL fetching (paste a YouTube/social link, get a file).
# Disabled by default. Requires a self-hosted cobalt instance with auth enabled.
COBALT_ENABLED=false
COBALT_API_URL=http://localhost:7272
# Required when COBALT_ENABLED=true (Authorization: Api-Key <key>)
COBALT_API_KEY=
# Optional second cobalt instance with YouTube session auth (cookies +
# poToken provider). Must be set together with its key; used when the
# primary refuses a YouTube link at client level.
#COBALT_SESSION_API_URL=http://localhost:7273
#COBALT_SESSION_API_KEY=
# Optional Bun SABR-fetch sidecar (packaging/bun-fetch): yt-dlp with Bun JS
# challenges + per-video PO tokens, ideally on the residential secondary box.
# Must be set together with its key; tried before the local yt-dlp tier.
#BUN_FETCH_URL=http://127.0.0.1:7673
#BUN_FETCH_KEY=
# Seconds between rescue-ladder passes for enforcement-gated YouTube links.
FETCH_EMPTY_RETRY_DELAY_SECS=10
# Tier-4 YouTube fallback: local yt-dlp + bgutil PO provider via proxies.
# YTDLP_JS_RUNTIME is comma-separated; Bun first (fastest EJS solver).
#YTDLP_FALLBACK=1
#YTDLP_BIN=/usr/local/bin/yt-dlp
#YTDLP_PROXY=http://10.200.0.2:8889
#YTDLP_PROXY_SECONDARY=http://100.81.219.120:8888
#YTDLP_POT_BASE_URL=http://100.81.219.120:4416
#YTDLP_TMPDIR=/var/lib/juicebox/ytdlp-tmp
#YTDLP_JS_RUNTIME=bun:/usr/local/bin/bun,deno:/usr/local/bin/deno
#YTDLP_COOKIES=/var/lib/juicebox/ytdlp-tmp/cookies.txt
